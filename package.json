{
  "name": "keisan-card",
  "version": "1.4.0",
  "private": true,
  "description": "けいさんカード（デジタル計算カード）。GitHub Pages で配信する静的 PWA。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/build.mjs --check && node scripts/check-project.mjs && node --test tests/*.test.mjs",
    "measure": "node tools/measure.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.26.10",
    "@babel/preset-react": "7.29.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "terser": "5.39.0"
  },
  "optionalDependencies": {
    "playwright": "1.50.1",
    "sharp": "0.35.3"
  }
}
